# Model provider: "openai" (default, Stage A) or "bedrock" (Stage B / Option A)
MODEL_PROVIDER=openai

# Required when MODEL_PROVIDER=openai
OPENAI_API_KEY=

# Required when MODEL_PROVIDER=bedrock (uses standard AWS credential chain otherwise)
AWS_REGION=us-east-1

# Neon Postgres connection string (Day 5 deployment; get this from neon.tech project dashboard)
DATABASE_URL=

# Chroma Cloud (get these from trychroma.com dashboard). Leave all three
# blank to fall back to a local PersistentClient (writes to data/chroma/)
# for local dev without a Chroma Cloud account.
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=
